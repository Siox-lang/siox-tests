module tests::index_overload;

using std::bits::unsigned;
using std::ops::{Index, IndexAssign, Range};

struct Pair {
    first: unsigned[8],
    second: unsigned[8]
}

impl Index<integer, unsigned> for Pair {
    fn index(self, index: integer) -> unsigned[8] {
        if index == 0 {
            return self.first;
        }
        return self.second;
    }
}

impl Index<Range, unsigned> for Pair {
    fn index(self, index: Range) -> unsigned[8] {
        if index.left == 0 and index.right == 0 {
            return self.first;
        }
        return self.second;
    }
}

impl IndexAssign<integer, unsigned> for Pair {
    fn index_assign(self, index: integer, value: unsigned[8]) {
        if index == 0 {
            self.first = value;
        } else {
            self.second = value;
        }
    }
}

entity IndexedPair {
    first: unsigned[8] in,
    second: unsigned[8] in,
    select: unsigned[1] in,
    selected: unsigned[8] out,
    ranged: unsigned[8] out
}

impl IndexedPair {
    let pair: Pair;
    pair[0] = first;
    pair[1] = second;
    selected = pair[integer(select)];
    ranged = pair[0..0];
}

#[test]
entity IndexOverloadTest {}

impl IndexOverloadTest {
    let first: unsigned[8];
    let second: unsigned[8];
    let select: unsigned[1];
    let selected: unsigned[8];
    let ranged: unsigned[8];

    let dut: IndexedPair = {
        .first = first,
        .second = second,
        .select = select,
        .selected = selected,
        .ranged = ranged,
    };

    first = 11;
    second = 29;
    select = 0;
    await 1ns;
    assert!(selected == 11, "integer Index overload should select first");
    assert!(ranged == 11, "Range Index overload should receive both bounds");

    select = 1;
    await 1ns;
    assert!(selected == 29, "integer Index overload should select second");
}
