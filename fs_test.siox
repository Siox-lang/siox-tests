module examples::fs_test;

using std::text::{unicode};

// std::fs is Rust-shaped: functions returning values, no handles, no modes,
// nothing to close. In initializer position the COMPILER reads the file
// (include_bytes! style) — the contents bake into the design, so the native
// binary carries its ROM even if the file disappears.
entity Rom { addr: unsigned[2] in, data: unsigned[8] out }
impl Rom {
    let mem: unsigned[8][4] = read("rom.bin");
    data = mem[0];
}

#[test]
entity FsTest {}
impl FsTest {
    let addr: unsigned[2] = 0; let data: unsigned[8];
    let d: Rom = { .addr = addr, .data = data };

    // Runtime read in the testbench (runner-side).
    let s: string = read_to_string("banner.txt");

    await 1ns;
    assert!(data == 17, "rom.bin[0] = 0x11, baked at compile time");
    assert!(unicode(s[0]) == 72, "banner 'H'");
    assert!(unicode(s[1]) == 105, "banner 'i'");
    // The file is read at build time, so its length is a compile-time
    // constant like any other array's — it used to be computed, used to lay
    // out the storage, and then thrown away.
    assert!(s'length == 2, "banner.txt is 2 chars");
    assert!(exists("rom.bin") == true, "exists");
    assert!(exists("nope.bin") == false, "not exists");
}
