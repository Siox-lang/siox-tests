module examples::spi_test;

using std::bits::unsigned;

// An SPI master (mode 0, MSB-first): on `start`, serialize `tx` onto `mosi`
// one bit per clock while sampling `miso` into a receive register. Eight bits,
// then the byte sits in `rx`. Serial wires are unsigned[1].
entity SpiMaster {
    clk: Bit in,
    start: Bit in,
    tx: unsigned[8] in,
    miso: unsigned[1] in,
    mosi: unsigned[1] out,
    rx: unsigned[8] out,
    busy: Logic out
}
impl SpiMaster {
    let shift_tx: unsigned[8] = 0;
    let shift_rx: unsigned[8] = 0;
    let bits: unsigned[4] = 0;
    let running: Bit = '0';

    if clk.rising() {
        if running {
            shift_rx = (shift_rx << 1) or unsigned[8](miso);
            shift_tx = shift_tx << 1;
            bits = bits + 1;
            if bits == 7 {
                running = '0';
            }
        } else {
            if start {
                shift_tx = tx;
                bits = 0;
                running = '1';
            }
        }
    }

    mosi = unsigned[1](shift_tx >> 7);
    rx   = shift_rx;
    busy = if running == '1' { '1' } else { '0' };
}

// Loopback harness: miso <- mosi wired in hardware (a testbench local can't
// carry a DUT output back into a DUT input, but instance wiring can).
entity SpiLoopback {
    clk: Bit in,
    start: Bit in,
    tx: unsigned[8] in,
    rx: unsigned[8] out,
    busy: Logic out
}
impl SpiLoopback {
    let wire: unsigned[1];
    let m: SpiMaster = {
        .clk = clk, .start = start, .tx = tx, .miso = wire, .mosi = wire, .rx = rx, .busy = busy
    };
}

#[test]
entity SpiTest {}
impl SpiTest {
    let clk: Bit = '0';
    let start: Bit = '0'; let tx: unsigned[8] = 0;
    let rx: unsigned[8]; let busy: Logic;
    let d: SpiLoopback = { .clk = clk, .start = start, .tx = tx, .rx = rx, .busy = busy };
    clk = not clk after 5ns;

    tx = 165;            // 0xA5 = 10100101
    start = '1'; await 10ns; start = '0';
    await 80ns;
    assert!(rx == 165, "SPI loopback: received == transmitted (0xA5)");
    assert!(busy == '0', "idle after the 8-bit transfer");
}
