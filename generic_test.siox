module examples::generic_test;

using std::bits::{signed};

// A type-generic function with a trait bound. `fn`s inline, so each call is a
// monomorphization: the body dispatches operators on the caller's concrete
// type (signed's signed `<=>` here, not the kernel unsigned compare), and the
// bound `T: Operator` (T supports operator overloading) is checked at the call
// site.
fn maxi<T: Operator>(a: T, b: T) -> T {
    if a > b { return a; }
    return b;
}

entity Pick { x: signed[8] in, y: signed[8] in, m: signed[8] out }
impl Pick { m = maxi(x, y); }

#[test]
entity GenericTest {}
impl GenericTest {
    let x: signed[8] = 5; let y: signed[8] = 251;   // y = -5
    let m: signed[8];
    let d: Pick = { .x = x, .y = y, .m = m };
    await 1ns;
    assert!(m == 5, "signed generic max: 5 > -5 via signed's <=> Operator");
}
