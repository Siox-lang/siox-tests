module tests::partial_range;

using std::bits::unsigned;

entity PartialRange {
    in value: unsigned[7..0];
    out upper: unsigned[4];
    out lower: unsigned[4];
    out whole: unsigned[8];
}

impl PartialRange {
    upper = value[..4];
    lower = value[3..];
    whole = value[..];
}

#[test]
entity PartialRangeTest {}

impl PartialRangeTest {
    let value: unsigned[8];
    let upper: unsigned[4];
    let lower: unsigned[4];
    let whole: unsigned[8];

    let dut: PartialRange = {
        .value = value,
        .upper = upper,
        .lower = lower,
        .whole = whole,
    };

    value = 0b10110110;
    await 1ns;
    assert!(upper == 0b1011, "`[..4]` should use the declared left bound");
    assert!(lower == 0b0110, "`[3..]` should use the declared right bound");
    assert!(whole == value, "`[..]` should preserve the complete declared range");
}
