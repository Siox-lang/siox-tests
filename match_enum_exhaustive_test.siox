module examples::match_enum_exhaustive_test;
enum Base { A, B, C }
enum Mid(Base);

entity E { sel: Mid in, y: unsigned[8] out }
impl E {
    y = match sel { Mid::A => 1, Mid::B => 2, Mid::C => 3 };
}
#[test]
entity T {}
impl T {
    let sel: Mid = Mid::B; let y: unsigned[8];
    let e: E = { .sel = sel, .y = y };
    await 1ns;
    assert!(y == 2, "match on a newtype enum");
}
