// A method called on a *generic* struct local.
//
// Lowering records a local's struct name — how a method call finds its impl —
// for a plain type (`Plain`) and for a view-applied one, and fell through for
// a generic one (`Box<unsigned[8]>`). So the receiver had no type name, no
// method was found, and the call was dropped without a word: the design
// compiled, ran, and left the field at its initial value.
//
// Every generic call below is paired with the identical call on a
// non-generic struct, so the two are compared against each other rather than
// against the compiler's own idea of what a method call does.
module generic_struct_method_test;

using std::bits::{unsigned};
using std::logic::{Bit};

struct Box<T> { v: T, tag: Bit }
impl<T> Box<T> {
    fn set(self, x: T) { self.v = x; }
    fn tagit(self) { self.tag = '1'; }
    fn doubled(self) -> T { return self.v + self.v; }
}

// The same shape without the parameter.
struct Plain { v: unsigned[8], tag: Bit }
impl Plain {
    fn set(self, x: unsigned[8]) { self.v = x; }
    fn tagit(self) { self.tag = '1'; }
    fn doubled(self) -> unsigned[8] { return self.v + self.v; }
}

entity Uses {
    genericV: unsigned[8] out,
    genericTag: Bit out,
    genericDoubled: unsigned[8] out,
    plainV: unsigned[8] out,
    plainTag: Bit out,
    plainDoubled: unsigned[8] out
}
impl Uses {
    let b: Box<unsigned[8]> = { .v = 0, .tag = '0' };
    b.set(7);
    b.tagit();
    genericV = b.v;
    genericTag = b.tag;
    genericDoubled = b.doubled();

    let p: Plain = { .v = 0, .tag = '0' };
    p.set(7);
    p.tagit();
    plainV = p.v;
    plainTag = p.tag;
    plainDoubled = p.doubled();
}

#[test]
entity GenericStructMethodTest {}
impl GenericStructMethodTest {
    let u: Uses = {};
    await 1ns;

    // A statement-position method call drives the field it writes.
    assert!(u.genericV == 7, "`b.set(7)` on a generic struct takes effect");
    assert!(u.genericTag == '1', "and a nullary method does too");

    // A value-returning method reads the receiver's field.
    assert!(u.genericDoubled == 14, "`b.doubled()` reads `self.v`");

    // The non-generic spelling is the control: identical calls, identical
    // results, so the generic path is measured against working hardware.
    assert!(u.genericV == u.plainV, "generic and plain agree on the write");
    assert!(u.genericTag == u.plainTag, "and on the flag");
    assert!(u.genericDoubled == u.plainDoubled, "and on the returned value");

    // The same calls on the *testbench* side. The emitter dispatches a call
    // statement on the callee's leading path segment; a method call's callee
    // is a field, so it matched nothing and was dropped without a word —
    // a mutating method did nothing here while the identical call in an
    // entity body above worked.
    let tb: Box<unsigned[8]> = { .v = 0, .tag = '0' };
    let tp: Plain = { .v = 0, .tag = '0' };
    await 1ns;
    tb.set(7);
    tp.set(7);
    tb.tagit();
    tp.tagit();
    await 1ns;

    assert!(tb.v == 7, "a method statement drives a testbench local too");
    assert!(tb.tag == '1', "including a nullary one");
    assert!(tb.doubled() == 14, "and a value-returning method reads it back");

    // Hardware and testbench agree on the same source.
    assert!(tb.v == u.genericV, "testbench and hardware agree");
    assert!(tb.doubled() == u.genericDoubled, "and on the returned value");
    // Generic and plain agree on the testbench side as well.
    assert!(tb.v == tp.v, "generic and plain agree in a testbench");
    assert!(tb.tag == tp.tag, "and on the flag");
}
