module examples::regfile_test;
using std::bits::unsigned;
entity RF {
    clk: Bit in,
    we: Bit in,
    waddr: unsigned[2] in,
    wdata: unsigned[8] in,
    raddr: unsigned[2] in,
    rdata: unsigned[8] out
}
impl RF {
    let regs: unsigned[8][4];
    if clk.rising() {
        if we {
            regs[waddr] = wdata;   // dynamic write
        }
    }
    rdata = regs[raddr];           // dynamic read
}
#[test] entity T {}
impl T {
    let clk: Bit = '0'; let we: Bit; let waddr: unsigned[2]; let wdata: unsigned[8];
    let raddr: unsigned[2]; let rdata: unsigned[8];
    let d: RF = { .clk = clk, .we = we, .waddr = waddr, .wdata = wdata, .raddr = raddr, .rdata = rdata };
    clk = not clk after 5ns;
    we = '1'; waddr = 2; wdata = 99; await 10ns;   // write reg[2]=99
    we = '0'; raddr = 2; await 10ns;
    assert!(rdata == 99, "wrote and read reg[2]");
}
