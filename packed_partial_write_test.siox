// Several partial writes to one packed vector must compose.
//
// Every write to a packed signal produces a *whole* new value for it, and the
// backend keeps only the last one that fires: event-block updates are staged
// from the pre-commit state and committed in order, and combinational drivers
// fold as `val = cond ? expr : val`. So each read-modify-write has to merge
// over the value its predecessors left behind. It did not:
//
//   * a clocked partial write merged over `Current(sig)` — the value *before*
//     the block — so `word[1] = '1'; word[3] = '1';` set bit 3 alone. Three
//     writes kept only the third; two disjoint slices kept only the second;
//     and `word = 15; word[7] = '1';` threw the 15 away and produced 128.
//   * combinationally, a constant bit index started routing through the
//     runtime-index expansion, which pushed a driver guarded by a constant-true
//     `hit`. Nothing then found the unconditional driver to merge over, so the
//     same statements produced 8 instead of 10 — and `word` drew an inferred
//     latch warning (W-P002) for a write that is not conditional at all.
//
// The testbench engine evaluates these statements sequentially in C and was
// right throughout, so each entity's result is asserted equal to the same
// arithmetic done there, as well as to the value Python computes.
module packed_partial_write_test;

using std::bits::unsigned;
using std::logic::Bit;

// Combinational: two disjoint constant bit writes.
entity Comb {
    q: unsigned[8] out
}
impl Comb {
    let word: unsigned[8] = 0;
    word[1] = '1';
    word[3] = '1';
    q = word;
}

// Clocked: three writes, then disjoint slices, then a whole-signal write
// followed by a bit write.
entity Clocked {
    clk: Bit in,
    three: unsigned[8] out,
    slices: unsigned[8] out,
    wholeThenBit: unsigned[8] out
}
impl Clocked {
    let a: unsigned[8] = 0;
    let b: unsigned[8] = 0;
    let c: unsigned[8] = 0;
    if clk.rising() {
        a[0] = '1';
        a[1] = '1';
        a[2] = '1';

        b[3..0] = "1111";
        b[7..4] = "1010";

        c = 15;
        c[7] = '1';
    }
    three = a;
    slices = b;
    wholeThenBit = c;
}

// Partial writes in *separate* event blocks of one impl. An impl block is one
// driver context (spec 3.14: override within, resolution across), so these
// compose exactly as they would inside a single block — a later write overrides
// only the bits it names. Each block still contributes only when its own event
// fires, which is what the two clocks here check.
entity Blocks {
    a: Bit in, b: Bit in,
    same: unsigned[8] out,     // both blocks on one clock
    split: unsigned[8] out,    // one block per clock
    whole: unsigned[8] out     // a whole-signal write, then a bit in another block
}
impl Blocks {
    let s: unsigned[8] = 0;
    if a.rising() { s[1] = '1'; }
    if a.rising() { s[3] = '1'; }
    same = s;

    let p: unsigned[8] = 0;
    if a.rising() { p[1] = '1'; }
    if b.rising() { p[3] = '1'; }
    split = p;

    let w: unsigned[8] = 0;
    if a.rising() { w = 15; }
    if b.rising() { w[7] = '1'; }
    whole = w;
}

// Two instances are two driver contexts and must not fold into each other.
entity Cell { clk: Bit in, q: unsigned[8] out }
impl Cell {
    let w: unsigned[8] = 0;
    if clk.rising() { w[0] = '1'; }
    if clk.rising() { w[2] = '1'; }
    q = w;
}

// A plain feed-through, so the testbench can slice-write a *connected signal*
// and read the result back out of an instance.
entity Pass {
    d: unsigned[8] in,
    q: unsigned[8] out
}
impl Pass {
    q = d;
}

// Two runtime indices with no clock at all. This is the case that needs the
// *combinational* half of the fix on its own: a runtime index produces a real
// guard, so neither write leaves an unconditional driver to merge over, and
// scanning for one finds only the `word = 0` default. Both writes then started
// from 0 and the second erased the first.
entity CombRuntime {
    i: unsigned[4] in,
    j: unsigned[4] in,
    q: unsigned[8] out
}
impl CombRuntime {
    let word: unsigned[8] = 0;
    word = 0;
    word[i] = '1';
    word[j] = '1';
    q = word;
}

// Two *runtime* indices in one clocked block, and a runtime write beside a
// constant one. `word[i]` and `word[j]` are separate bits whenever i != j.
entity Runtime {
    clk: Bit in,
    i: unsigned[4] in,
    j: unsigned[4] in,
    two: unsigned[8] out,
    mixed: unsigned[8] out
}
impl Runtime {
    let w: unsigned[8] = 0;
    let m: unsigned[8] = 0;
    if clk.rising() {
        w[i] = '1';
        w[j] = '1';

        m[i] = '1';
        m[0] = '1';
    }
    two = w;
    mixed = m;
}

#[test]
entity PackedPartialWriteTest {}
impl PackedPartialWriteTest {
    let clk: Bit = '0';

    let cq: unsigned[8];
    let comb: Comb = { .q = cq };

    let three: unsigned[8];
    let slices: unsigned[8];
    let wtb: unsigned[8];
    let seq: Clocked = {
        .clk = clk,
        .three = three,
        .slices = slices,
        .wholeThenBit = wtb,
    };

    let i: unsigned[4] = 1;
    let j: unsigned[4] = 3;
    let two: unsigned[8];
    let mixed: unsigned[8];
    let rt: Runtime = { .clk = clk, .i = i, .j = j, .two = two, .mixed = mixed };

    let ri: unsigned[4] = 1;
    let rj: unsigned[4] = 3;
    let rq: unsigned[8];
    let cr: CombRuntime = { .i = ri, .j = rj, .q = rq };

    let pd: unsigned[8] = 0;
    let pq: unsigned[8];
    let pass: Pass = { .d = pd, .q = pq };

    let ba: Bit = '0';
    let bb: Bit = '0';
    let bsame: unsigned[8];
    let bsplit: unsigned[8];
    let bwhole: unsigned[8];
    let blocks: Blocks = {
        .a = ba, .b = bb,
        .same = bsame, .split = bsplit, .whole = bwhole,
    };

    let cell1q: unsigned[8];
    let cell1: Cell = { .clk = ba, .q = cell1q };
    let cell2q: unsigned[8];
    let cell2: Cell = { .clk = bb, .q = cell2q };

    await 1ns;
    // Combinational, with no clock at all: bit 1 and bit 3 are both set.
    assert!(cq == 10, "two combinational bit writes both land — this gave 8");
    assert!(rq == 10, "and two combinational *runtime* writes do too");

    clk = '1'; await 1ns; clk = '0'; await 1ns;

    // Three writes to three bits of one register: 0b00000111.
    assert!(three == 7, "three clocked bit writes compose — this gave 4");
    // 0xA0 | 0x0F: the high nibble and the low nibble.
    assert!(slices == 175, "two disjoint slice writes compose — this gave 160");
    // The whole-signal write is a base the bit write merges over, not
    // something a later partial write discards.
    assert!(wtb == 143, "`c = 15; c[7] = '1'` keeps the 15 — this gave 128");

    // Runtime indices, on distinct bits.
    assert!(two == 10, "two runtime bit writes both land — this gave 8");
    // A runtime write and a constant write to the same register.
    assert!(mixed == 3, "a runtime write survives a later constant one");

    // The same index twice: the second write is the one that decides the bit,
    // and it must not disturb bit 1 written on the previous edge.
    i = 5; j = 5; await 1ns;
    clk = '1'; await 1ns; clk = '0'; await 1ns;
    assert!(two == 42, "the same runtime index twice sets the bit once");

    // An out-of-range runtime index is a no-op and must not wipe the register.
    i = 2; j = 9; await 1ns;
    clk = '1'; await 1ns; clk = '0'; await 1ns;
    assert!(two == 46, "an out-of-range runtime write changes nothing else");

    // The testbench engine runs the same statements sequentially in C. It was
    // right while hardware was wrong, so it is the independent check here.
    let t: unsigned[8] = 0;
    t[1] = '1';
    t[3] = '1';
    let v: unsigned[8] = 15;
    v[7] = '1';
    await 1ns;
    assert!(t == 10, "the testbench composes bit writes too");
    assert!(v == 143, "and a bit write over a whole-signal write");
    assert!(t == cq, "and both engines agree on the combinational form");
    assert!(v == wtb, "and on the whole-then-bit form");

    // A *slice* write to a testbench value was "unsupported assignment target"
    // — no code, no span — after the frontend had accepted it, while hardware
    // has lowered the same statement since ranges landed. Building a stimulus
    // word a nibble at a time is the ordinary way to write one.
    let u: unsigned[8] = 0;
    u[3..0] = "1111";
    u[7..4] = "1010";
    await 1ns;
    assert!(u == 175, "the testbench writes slices");
    assert!(u == slices, "and places the same bits hardware does");

    // A slice wider than a nibble, and a declared range that does not start at
    // zero: `unsigned[15..8]` puts label 8 at storage bit 0, so `y[11..8]` is
    // the low four bits.
    let x: unsigned[16] = 0;
    x[11..4] = 255;
    let y: unsigned[15..8] = 0;
    y[11..8] = "1111";
    await 1ns;
    assert!(x == 4080, "an eight-bit slice at offset four is 255 << 4");
    assert!(y == 15, "declared labels map onto compact storage");

    // The same slice writes on a *connected signal* rather than a local: the
    // alias fan-out is a separate path in the emitter, so it needs its own
    // case.
    pd[3..0] = "1111";
    pd[7..4] = "1010";
    await 1ns;
    assert!(pq == 175, "a slice write reaches a connected instance too");

    // Separate event blocks of one impl. Only `a` rises first, so the blocks
    // guarded by `b` must contribute nothing yet.
    ba = '1'; await 1ns; ba = '0'; await 1ns;
    assert!(bsame == 10, "two blocks on one clock compose — this gave 8");
    assert!(bsplit == 2, "a block whose event has not fired contributes nothing");
    assert!(bwhole == 15, "the whole-signal write lands on its own clock");
    assert!(cell1q == 5, "and the same holds inside an instance");
    assert!(cell2q == 0, "while a second instance is its own driver context");

    // Now `b` rises: its bit joins, and the bit written on `a` survives.
    bb = '1'; await 1ns; bb = '0'; await 1ns;
    assert!(bsplit == 10, "the earlier block's bit survives the later one");
    assert!(bwhole == 143, "a bit write in another block keeps the 15");
    assert!(cell2q == 5, "the second instance now composes its own two blocks");

    // Both events in one delta: the later block still merges over the earlier.
    ba = '1'; bb = '1'; await 1ns; ba = '0'; bb = '0'; await 1ns;
    assert!(bsplit == 10, "both blocks firing together set both bits");
    assert!(bwhole == 143, "and the bit write still merges over the 15");
}
