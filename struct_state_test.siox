// A struct whose fields are clocked state. Spec 3.13's next-state rule has to
// apply per field, so an exchange between two fields of one struct swaps them
// rather than copying one over the other — the same guarantee two separate
// signals get. Nothing in the corpus held a struct as register state.
module struct_state_test;

using std::bits::{unsigned};

struct Pair { a: unsigned[8], b: unsigned[8] }
struct Acc { total: unsigned[8], count: unsigned[8] }

entity Swapper {
    clk: Bit in,
    x: unsigned[8] out,
    y: unsigned[8] out
}
impl Swapper {
    let p: Pair = { .a = 1, .b = 2 };
    if clk.rising() {
        p.a = p.b;
        p.b = p.a;
    }
    x = p.a;
    y = p.b;
}

entity Accumulate {
    clk: Bit in,
    rst: Bit in,
    d: unsigned[8] in,
    sum: unsigned[8] out,
    n: unsigned[8] out,
    mean: unsigned[8] out
}
impl Accumulate {
    let a: Acc = { .total = 0, .count = 0 };
    if clk.rising() {
        if rst == '1' { a.total = 0; a.count = 0; }
        else { a.total = a.total + d; a.count = a.count + 1; }
    }
    sum = a.total;
    n = a.count;
    mean = if a.count == 0 { 0 } else { a.total / a.count };
}

#[test]
entity StructStateTest {}
impl StructStateTest {
    let clk: Bit = '0';
    let rst: Bit = '1';
    let d: unsigned[8] = 0;
    let sw: Swapper = { .clk = clk };
    let ac: Accumulate = { .clk = clk, .rst = rst, .d = d };
    await 1ns;

    assert!(sw.x == 1 and sw.y == 2, "initial field values");

    clk = '1'; await 1ns; clk = '0'; await 1ns;
    assert!(sw.x == 2 and sw.y == 1, "the fields exchange rather than one winning");
    clk = '1'; await 1ns; clk = '0'; await 1ns;
    assert!(sw.x == 1 and sw.y == 2, "and exchange back");

    // Both fields advance on the same edge, and a value derived from the two
    // sees a consistent pair.
    rst = '0';
    d = 10;
    for i in 0..2 {
        clk = '1'; await 1ns; clk = '0'; await 1ns;
    }
    assert!(ac.n == 3, "three edges after reset");
    assert!(ac.sum == 30, "three additions of ten");
    assert!(ac.mean == 10, "a combination of both fields is consistent");
}
