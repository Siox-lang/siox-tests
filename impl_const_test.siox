// A constant declared *inside* an implementation (spec 3.3, which shows
// `const MAX: unsigned[W] = (1 << W) - 1;` in exactly this position). Only
// module-level constants were ever collected, so these compiled and then
// every read of the name reported it as unknown.
//
// They fold per instance, because the spec's own example depends on the
// entity's parameters — the same declaration is a different number in each
// instantiation.
module impl_const_test;

using std::bits::{unsigned};

entity Plain {
    y: unsigned[8] out
}
impl Plain {
    const LIMIT: unsigned[8] = 5;
    y = LIMIT;
}

entity Sized<W: integer> {
    y: unsigned[8] out
}
impl<W: integer> Sized<W> {
    const MAX: unsigned[8] = (1 << W) - 1;
    y = MAX;
}

// The same, through a binder that renames the parameter.
entity Doubled<W: integer> {
    y: unsigned[8] out
}
impl<V: integer> Doubled<V> {
    const TWICE: unsigned[8] = V * 2;
    y = TWICE;
}

// Constants are order-independent, and may be defined in terms of each other.
entity Chained<W: integer> {
    y: unsigned[8] out
}
impl<W: integer> Chained<W> {
    const OUTER: unsigned[8] = INNER + 1;
    const INNER: unsigned[8] = W * 3;
    y = OUTER;
}

// A constant also has to be visible where *types* and *indices* resolve, not
// only in expressions: array sizes and slice bounds go through the parameter
// environment, and a constant missing from it left `let regs: unsigned[8][N]`
// with no elements at all.
entity Shaped<W: integer> {
    d: unsigned[8] in,
    count: integer out,
    sliced: unsigned[8] out,
    last: unsigned[8] out
}
impl<W: integer> Shaped<W> {
    const N: integer = W + 1;
    const TOP: integer = W - 1;

    let regs: unsigned[8][N];
    // Each iteration drives a *different* element, so this accumulates
    // rather than overriding one signal.
    for i in 0..N - 1 { regs[i] = d + i; }

    count = regs'length;
    sliced = unsigned[8](d[TOP..0]);
    last = regs[N - 1];
}

// Every *kind* of constant, in both positions. The first version of
// implementation constants folded integers only, so a lookup table or a real
// declared inside an implementation reported its own name as unknown while
// the module-level spelling worked. A range constant used as a width was
// worse than that: it compiled, and produced a signal of zero bits.
const OUTER_SPAN: range = 7..0;

entity Kinds {
    sel: unsigned[8] in,
    table: unsigned[8] out,
    inner_len: integer out,
    outer_len: integer out
}
impl Kinds {
    const TAB: unsigned[8][4] = [10, 20, 30, 40];
    const SPAN: range = 15..0;

    table = TAB[sel];
    let narrow: unsigned[OUTER_SPAN];
    let wide: unsigned[SPAN];
    outer_len = narrow'length;
    inner_len = wide'length;
}

#[test]
entity ImplConstTest {}
impl ImplConstTest {
    let plain: Plain = {};
    let four: Sized<W = 4> = {};
    let six: Sized<W = 6> = {};
    let doubled: Doubled<W = 7> = {};
    let chained: Chained<W = 5> = {};
    let d: unsigned[8] = 0xA5;
    let shaped2: Shaped<W = 2> = { .d = d };
    let shaped4: Shaped<W = 4> = { .d = d };
    let sel: unsigned[8] = 2;
    let kinds: Kinds = { .sel = sel };
    await 1ns;

    assert!(plain.y == 5, "a constant with no parameters");
    // One declaration, two instances, two values.
    assert!(four.y == 15, "(1 << 4) - 1");
    assert!(six.y == 63, "(1 << 6) - 1");
    assert!(doubled.y == 14, "a renamed binder reaches the constant");
    assert!(chained.y == 16, "5 * 3 + 1, declared out of order");

    // 0xA5 = 1010_0101. Widths and masks computed separately, not read back.
    assert!(shaped2.count == 3, "the array is sized by the constant");
    assert!(shaped4.count == 5, "and differently in each instance");
    assert!(shaped2.sliced == 1, "0xA5 masked to the low 2 bits");
    assert!(shaped4.sliced == 5, "and to the low 4");
    assert!(shaped2.last == 0xA5 + 2, "the last element the loop drove");
    assert!(shaped4.last == 0xA5 + 4, "one element further at the wider size");

    assert!(kinds.table == 30, "a lookup table declared inside the impl");
    // A range says a span, not a width: `7..0` is eight bits, `15..0` sixteen.
    assert!(kinds.outer_len == 8, "a module range constant as a width");
    assert!(kinds.inner_len == 16, "and one declared inside the impl");
}
