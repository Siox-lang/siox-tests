module examples::where_test;
use std::bits::signed;

// The `where` form — identical to `fn maxi<T: Ord<T>>`.
fn maxi<T>(a: T, b: T) -> T
where
    T: Ord<T>,
{
    if a > b { return a; }
    return b;
}

entity Pick { x: signed[8] in, y: signed[8] in, m: signed[8] out }
impl Pick { m = maxi(x, y); }

#[test]
entity WhereTest {}
impl WhereTest {
    let x: signed[8] = 5; let y: signed[8] = 251;
    let m: signed[8];
    let d: Pick = { .x = x, .y = y, .m = m };
    await 1ns;
    assert!(m == 5, "where-bounded generic max dispatches signed Ord");
}
