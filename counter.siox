module examples::counter;

using std::logic::{Bit, Logic};
using std::bits::unsigned;

// A parameterized up-counter with synchronous reset and enable.
#[top]
entity Counter<W: integer> {
    clk: Bit in,
    rst: Logic in,
    en: Bit in,
    count: unsigned[W] out
}

impl<W: integer> Counter<W> {
    let value: unsigned[W] = 0;

    if clk.rising() {
        if rst == '1' {
            value = 0;
        } else if en {
            value = value + 1;
        }
    }

    count = value;
}
