module examples::family_test;

// A user-defined nominal Logic-array family behaves like unsigned with no
// compiler knowledge of its name or representation marker.
struct Word(Logic[]);

entity E { a: Word[8] in, y: Word[8] out }
impl E { y = a; }

#[test]
entity FamTest {}
impl FamTest {
    let a: Word[8] = 200; let y: Word[8];
    let d: E = { .a = a, .y = y };
    await 1ns;
    assert!(y == 200, "user Logic-vector family: width + literal + eq");
}
