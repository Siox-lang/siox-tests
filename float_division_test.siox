module float_division_test;

// IEEE-754 float division and fixed <-> float conversions, in hardware and a
// testbench. Words are checked exactly: 1/3 and 2/3 in binary32 are
// 0x3EAAAAAB and 0x3F2AAAAB, rounded to nearest even.

use std::fixed::{ufixed, sfixed};
use std::float::float;

entity Divider {
    a: float<32, 23> in, b: float<32, 23> in, x: ufixed<8, 4> in,
    q: float<32, 23> out, xf: float<32, 23> out, back: sfixed<8, 4> out,
}

impl Divider {
    q = a / b;
    xf = float<32, 23>(x);
    back = sfixed<8, 4>(a);
}

#[test]
entity FloatDivisionTest {}

impl FloatDivisionTest {
    let a: float<32, 23>; let b: float<32, 23>; let x: ufixed<8, 4>;
    let q: float<32, 23>; let xf: float<32, 23>; let back: sfixed<8, 4>;
    let dut: Divider = { .a = a, .b = b, .x = x, .q = q, .xf = xf, .back = back };

    check: process {
        a = float<32, 23>(1.0); b = float<32, 23>(3.0); x = ufixed<8, 4>(2.6875);
        await 1ns;
        assert!(integer(q) == 1051372203, "hardware 1/3 is 0x3EAAAAAB");
        assert!(xf.to_real() == 2.6875, "ufixed to float is exact here");
        assert!(back.to_real() == 1.0, "float to sfixed");
        a = float<32, 23>(0.0 - 3.14159); b = float<32, 23>(0.0);
        await 1ns;
        assert!(q.is_infinite() and q < b, "-x / 0 is -inf");
        assert!(back.to_real() == 0.0 - 3.125, "rounded to the nearest sixteenth");

        let one: float<32, 23> = float<32, 23>(1.0);
        let zero: float<32, 23> = float<32, 23>(0.0);
        let inf: float<32, 23> = one / zero;
        let two_thirds: float<32, 23> = float<32, 23>(2.0) / float<32, 23>(3.0);
        let nan: float<32, 23> = zero / zero;
        assert!(integer(two_thirds) == 1059760811, "2/3 is 0x3F2AAAAB");
        assert!((float<32, 23>(7.5) / float<32, 23>(2.5)).to_real() == 3.0, "exact quotient");
        assert!(nan.is_nan() and (inf / inf).is_nan(), "0/0 and inf/inf are NaN");
        assert!((one / inf).is_zero(), "x / inf is zero");

        let big: float<32, 23> = float<32, 23>(100.0);
        let tie: float<32, 23> = float<32, 23>(0.03125);
        let u: ufixed<8, 4> = ufixed<8, 4>(big);
        let t: ufixed<8, 4> = ufixed<8, 4>(tie);
        let s: sfixed<8, 4> = sfixed<8, 4>(zero - big);
        let n: sfixed<8, 4> = sfixed<8, 4>(nan);
        assert!(u.to_real() == 15.9375, "saturates at the top of ufixed<8, 4>");
        assert!(t.to_real() == 0.0625, "a tie rounds away from zero");
        assert!(s.to_real() == 0.0 - 8.0, "saturates at the bottom of sfixed<8, 4>");
        assert!(n.to_real() == 0.0, "NaN converts to zero");
    }
}
