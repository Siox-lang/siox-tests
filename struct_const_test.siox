// A struct-typed `const`.
//
// `const K: Pair = { .a = 4, .b = 5 }` type-checked with no diagnostic and then
// failed in both back ends, differently:
//
//   * hardware: `K.a` reported "has no hardware form" (E-P017) — a message
//     about runtime indices, on a source containing no index — and reading `K`
//     whole reported the name as unknown (E-P001);
//   * the testbench: "references `K.a`, which siox build cannot translate yet".
//
// Nothing folded the declaration, so the constant never entered either engine's
// table. A scalar `const N: unsigned[8] = 5` folded and worked in both.
//
// A struct constant is one folded value per field, keyed by the dotted path a
// read spells, in both engines. Read whole it is those fields together, which
// an assignment expands per leaf.
//
// Which reading applies is decided by the *assigned type*, not by the braces: a
// positional literal `{ 6, 7 }` lexes as a concatenation, and against a struct
// type it is the positional form of the same literal. Against an array or a
// packed vector the identical braces stay a concatenation, which is the control
// at the end.
//
// Every expected value is the arithmetic written beside it, not a reading taken
// from a run.
module struct_const_test;

using std::bits::unsigned;

struct Pair { a: unsigned[8], b: unsigned[8] }
struct Limits { lo: unsigned[8], hi: unsigned[8] }

entity Consts {
    fa: unsigned[8] out, fb: unsigned[8] out,   // field reads
    sum: unsigned[8] out,                       // fields in arithmetic
    wa: unsigned[8] out, wb: unsigned[8] out,   // assigned whole, then read
    ia: unsigned[8] out, ib: unsigned[8] out,   // used as a `let` initializer
    pa: unsigned[8] out, pb: unsigned[8] out,   // positional constant
    cat: unsigned[8] out,                       // the control: still a concat
    span: unsigned[8] out                       // a second constant, in a guard
}
impl Consts {
    const K: Pair = { .a = 4, .b = 5 };
    const P: Pair = { 6, 7 };
    const L: Limits = { .lo = 2, .hi = 9 };

    fa = K.a;
    fb = K.b;
    sum = K.a + K.b;

    let whole: Pair;
    whole = K;
    wa = whole.a; wb = whole.b;

    let seeded: Pair = K;
    ia = seeded.a; ib = seeded.b;

    pa = P.a; pb = P.b;

    // The control: the same brace syntax against a packed vector is still a
    // bit concatenation, because the assigned type decides.
    let hi: unsigned[4] = 10;   // 1010
    let lo: unsigned[4] = 3;    // 0011
    cat = { hi, lo };           // 10100011

    // A constant's fields in a condition, which is the point of having one.
    span = if L.hi > L.lo { L.hi - L.lo } else { 0 };
}

#[test]
entity StructConstTest {}
impl StructConstTest {
    const T: Pair = { .a = 11, .b = 12 };
    // A positional constant in the testbench itself: the native emitter
    // folds its own constant tables, so it needs its own case.
    const U: Pair = { 21, 22 };

    let fa: unsigned[8]; let fb: unsigned[8]; let sum: unsigned[8];
    let wa: unsigned[8]; let wb: unsigned[8];
    let ia: unsigned[8]; let ib: unsigned[8];
    let pa: unsigned[8]; let pb: unsigned[8]; let cat: unsigned[8];
    let span: unsigned[8];
    let c: Consts = {
        .fa = fa, .fb = fb, .sum = sum, .wa = wa, .wb = wb,
        .ia = ia, .ib = ib, .pa = pa, .pb = pb, .cat = cat, .span = span,
    };

    await 1ns;

    // Hardware. Each of these was E-P017 or E-P001 before.
    assert!(fa == 4, "a struct constant's field reads as its value");
    assert!(fb == 5, "in both fields");
    assert!(sum == 9, "and the fields take part in arithmetic");
    assert!(wa == 4, "the constant read whole assigns per leaf");
    assert!(wb == 5, "field for field");
    assert!(ia == 4, "and seeds a `let` initializer");
    assert!(ib == 5, "in both fields");
    assert!(pa == 6, "a positional constant binds by declaration order");
    assert!(pb == 7, "field for field");
    assert!(cat == 163, "the same braces against a vector still concatenate");
    assert!(span == 7, "9 - 2, with the comparison on constant fields");

    // The testbench engine folds its own constants, and refused this outright.
    let x: unsigned[8];
    let y: unsigned[8];
    x = T.a;
    y = T.a + T.b;
    await 1ns;
    assert!(x == 11, "the testbench reads a struct constant's field");
    assert!(y == 23, "and uses it in arithmetic");

    let u1: unsigned[8];
    let u2: unsigned[8];
    u1 = U.a;
    u2 = U.b;
    await 1ns;
    assert!(u1 == 21, "a positional constant folds in the testbench too");
    assert!(u2 == 22, "field for field");

    // The two engines on the same constant, so neither can drift alone.
    assert!(fa == 4, "hardware still agrees");
    assert!(x == 11, "and the testbench does too");
}
