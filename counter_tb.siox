module examples::counter_tb;

using std::logic::{Bit, Logic};
using std::bits::unsigned;

// The device under test: a parameterized counter.
entity Counter<W: integer> {
    clk: Bit in,
    rst: Logic in,
    en: Bit in,
    count: unsigned[W] out
}

impl<W: integer> Counter<W> {
    let value: unsigned[W] = 0;

    if clk.rising() {
        if rst == '1' {
            value = 0;
        } else if en {
            value = value + 1;
        }
    }

    count = value;
}

// A concrete top-level harness that instantiates the counter at W = 8.
#[top]
entity Harness {}

impl Harness {
    let clk: Bit = '0';
    let rst: Logic = '1';
    let en: Bit = '1';
    let count: unsigned[8];

    let dut: Counter<W = 8> = {
        .clk = clk,
        .rst = rst,
        .en = en,
        .count = count,
    };
}
