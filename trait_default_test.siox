// A trait method with a body is a default the implementor may omit.
//
// The type checker already worked this way: `trait_required` counts only the
// body-less methods, so `impl Meter for Plain { fn raw(..) }` — omitting the
// two defaulted methods — is a complete implementation and is accepted.
// Dispatch did not agree. All three method tables (the checker's, lowering's
// and the emitter's) were built from `impl` items alone, so calling an
// inherited default failed with "`Plain` has no method `scaled`": the language
// accepted an implementation and then refused to let anyone call it.
//
// std shows the cost — `ClockLike`'s three methods are written out verbatim
// for `Logic` and again for `Bit`, which is what you do when defaults do not
// work.
module trait_default_test;

using std::bits::{unsigned};

trait Meter {
    // Required: no body.
    fn raw(self) -> unsigned[8];
    // Defaulted, and calls another trait method — so the default must
    // dispatch back to the *implementor's* `raw`, not to some fixed one.
    fn scaled(self) -> unsigned[8] { return self.raw() * 2; }
    // Defaulted and self-contained.
    fn label(self) -> unsigned[8] { return 100; }
}

// Inherits both defaults.
struct Plain { v: unsigned[8] }
impl Meter for Plain {
    fn raw(self) -> unsigned[8] { return self.v; }
}

// Overrides one default, inherits the other.
struct Custom { v: unsigned[8] }
impl Meter for Custom {
    fn raw(self) -> unsigned[8] { return self.v; }
    fn scaled(self) -> unsigned[8] { return self.raw() * 10; }
}

// The other shapes an implementor can take. A default has to be inherited
// whatever the impl target is, and a `self`-less default is an associated
// function reached as `Type::name()`, through a different table again.
enum Mode { Slow, Fast }
impl Meter for Mode {
    fn raw(self) -> unsigned[8] { return if self == Mode::Fast { 10 } else { 2 }; }
}

trait Named {
    fn tag() -> unsigned[8] { return 77; }
    fn other() -> unsigned[8] { return 5; }
}
struct Thing { }
impl Named for Thing {
    fn other() -> unsigned[8] { return 9; }   // overrides one static default
}

entity Uses {
    pRaw: unsigned[8] out, pScaled: unsigned[8] out, pLabel: unsigned[8] out,
    cRaw: unsigned[8] out, cScaled: unsigned[8] out, cLabel: unsigned[8] out,
    enumScaled: unsigned[8] out,
    staticTag: unsigned[8] out, staticOther: unsigned[8] out
}
impl Uses {
    let p: Plain = { .v = 3 };
    pRaw = p.raw();
    pScaled = p.scaled();
    pLabel = p.label();

    let c: Custom = { .v = 3 };
    cRaw = c.raw();
    cScaled = c.scaled();
    cLabel = c.label();

    // An enum implementor inherits the same default.
    let m: Mode = Mode::Fast;
    enumScaled = m.scaled();

    // A `self`-less default, and one the impl overrides.
    staticTag = Thing::tag();
    staticOther = Thing::other();
}

#[test]
entity TraitDefaultTest {}
impl TraitDefaultTest {
    let u: Uses = {};
    await 1ns;

    // Inherited defaults, in hardware.
    assert!(u.pRaw == 3, "the required method is the implementor's");
    assert!(u.pScaled == 6, "an inherited default runs: raw * 2");
    assert!(u.pLabel == 100, "and a self-contained default too");

    // An override wins over the default, and the default it did *not*
    // override is still inherited.
    assert!(u.cScaled == 30, "an override wins: raw * 10");
    assert!(u.cLabel == 100, "while the untouched default is still inherited");

    // The two implementors disagree on `scaled` and agree on `label`, which
    // is only possible if each got its own resolution rather than a shared one.
    assert!(u.pScaled != u.cScaled, "each type resolves `scaled` for itself");
    assert!(u.pLabel == u.cLabel, "and both share the one default `label`");

    // The same calls on the testbench side: a separate method table, built the
    // same way and previously missing defaults the same way.
    let p: Plain = { .v = 3 };
    let c: Custom = { .v = 3 };
    await 1ns;

    assert!(p.scaled() == 6, "the testbench inherits the default too");
    assert!(p.label() == 100, "including the self-contained one");
    assert!(c.scaled() == 30, "and honours an override");
    assert!(c.label() == 100, "while inheriting the rest");

    // Hardware and testbench agree on every one of them.
    assert!(p.scaled() == u.pScaled, "engines agree on an inherited default");
    assert!(c.scaled() == u.cScaled, "and on an override");
    assert!(p.label() == u.pLabel, "and on a shared default");

    // An enum is an implementor like any other: 10 * 2 through the default.
    assert!(u.enumScaled == 20, "an enum inherits the trait default");

    // A `self`-less default is an associated function, and an impl's own
    // static wins over it.
    assert!(u.staticTag == 77, "a static default is inherited as `Type::name()`");
    assert!(u.staticOther == 9, "and an impl's own static overrides it");
    assert!(Thing::tag() == 77, "the testbench inherits the static default too");
    assert!(Thing::other() == 9, "and honours the override");
    assert!(Thing::tag() == u.staticTag, "both engines agree on the static default");
}
