module examples::top_counter;

// A concrete top-level design: a fixed-width free-running counter with reset.
// `sioxc` compiles this sole structural root to a native object —
// no testbench involved.

use std::logic::Logic;
use std::bits::unsigned;

entity Counter8 {
    clk: Bit in,
    rst: Logic in,
    count: unsigned[8] out
}

impl Counter8 {
    let value: unsigned[8] = 0;

    update: process {
        if clk.rising() {
            if rst == '1' {
                value = 0;
            } else {
                value = value + 1;
            }
        }
    }

    count = value;
}
