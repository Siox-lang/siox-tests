module examples::bit_string_test;

// Bit-string prefixes are radix conversions declared by
// `impl Prefix<"x", string> for unsigned` (and `"o"`) in std. The compiler names
// the trait while std owns which prefixes exist:
//   x"…" — 4 bits/hex digit, 2-value
//   o"…" — 3 bits/octal digit, 2-value
// A plain string needs no prefix: a string of logic values reads as a Logic
// array by context (`"1010"`, metavalues too — see string_to_array_test).

using std::attrs::{test};

entity Probe {
    h: unsigned[16] out,   // x"BEEF"
    o: unsigned[6] out,    // o"17"  = 001_111 = 15
    o2: unsigned[9] out,   // o"725" = 111_010_101 = 469
    s: unsigned[4] out,    // bare "1010" = 10
}

impl Probe {
    let hv: unsigned[16] = x"BEEF";
    let ov: unsigned[6]  = o"17";
    let o2v: unsigned[9] = o"725";
    let sv: unsigned[4]  = "1010";     // no prefix
    h = hv;   o = ov;   o2 = o2v;   s = sv;
}

#[test]
entity BitStringTest {}

impl BitStringTest {
    let h: unsigned[16]; let o: unsigned[6]; let o2: unsigned[9]; let s: unsigned[4];
    let dut: Probe = { .h = h, .o = o, .o2 = o2, .s = s };

    assert!(h == 0xBEEF, "x\"BEEF\" = 0xBEEF");
    assert!(o == 15, "o\"17\" = 15");
    assert!(o2 == 469, "o\"725\" = 469");
    assert!(s == 10, "bare \"1010\" = 10");
}
