module examples::stream_bus_test;

// A ready/valid `Stream` interface with distinct directional views. The Source
// drives valid/data and reads ready; the Sink mirrors it. Connecting two
// instances to one `Stream` net wires each leaf in its own direction.

using std::logic::{Bit};
using std::bits::unsigned;

struct Stream { valid: Bit, ready: Bit, data: unsigned[8] }

view Source for Stream { valid out, data out, ready in }
view Sink for Stream { valid in, data in, ready out }

entity Producer { bus: Stream Source, d: unsigned[8] in, go: Bit in, canpush: Bit out }
impl Producer {
    bus.valid = go;
    bus.data = d;
    canpush = bus.ready;     // ready flows back from the Sink
}

entity Consumer { bus: Stream Sink, accept: Bit in, got: unsigned[8] out, seen: Bit out }
impl Consumer {
    bus.ready = accept;      // ready flows toward the Source
    got = bus.data;
    seen = bus.valid;
}

#[top]
entity Link { d: unsigned[8] in, go: Bit in, accept: Bit in,
              got: unsigned[8] out, seen: Bit out, canpush: Bit out }
impl Link {
    let s: Stream;
    let p: Producer = { .bus = s, .d = d, .go = go, .canpush = canpush };
    let c: Consumer = { .bus = s, .accept = accept, .got = got, .seen = seen };
}

#[test]
entity StreamBusTest {}
impl StreamBusTest {
    let d: unsigned[8]; let go: Bit; let accept: Bit;
    let got: unsigned[8]; let seen: Bit; let canpush: Bit;
    let dut: Link = { .d = d, .go = go, .accept = accept, .got = got, .seen = seen, .canpush = canpush };

    d = 0xAB; go = '1'; accept = '1';
    await 1ns;
    assert!(got == 0xAB, "data flows Source -> Sink");
    assert!(seen == '1', "valid flows Source -> Sink");
    assert!(canpush == '1', "ready flows Sink -> Source");

    accept = '0';
    await 1ns;
    assert!(canpush == '0', "ready deasserts back at the Source");
}
