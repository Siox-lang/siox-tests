// Negative values inside a generate loop.
//
// A negative constant expression written *outside* a loop was always right:
// `v[0] = signed[16](0 - 5)` stores -5. The same expression inside a `for`
// body stored 0, and nothing said so.
//
// The loop was the trigger, not the index — `for i in 0..0 { v[2] = signed[16](0 - 5); }`
// is wrong even though `i` never appears in the value. Unrolling folds each
// substituted expression through `fold_const`, which turned the folded `i64`
// back into `Expr::Int { text: "-5" }`. The lexer never produces an `Int` whose
// text carries a sign, so `parse_int` rejects it, the expression is demoted to
// non-constant, and what reaches hardware is 0.
//
// Every expected value below is what Python computes for the same arithmetic.
module generate_negative_test;

using std::bits::{signed};

entity Neg {
    // `k - 5` for k in 0..3 -> -5, -4, -3, -2
    n0: signed[16] out, n1: signed[16] out, n2: signed[16] out, n3: signed[16] out,
    nSum: signed[16] out,
    // `0 - i` over a descending range -> v[0]=0 .. v[3]=-3
    d0: signed[16] out, d3: signed[16] out, dSum: signed[16] out,
    // negative loop *bounds*: `i * 3` for i in -2..2 -> -6, -3, 0, 3, 6
    b0: signed[16] out, b1: signed[16] out, b2: signed[16] out,
    b3: signed[16] out, b4: signed[16] out,
    // `i * i - 10` for i in 0..4 -> -10, -9, -6, -1, 6
    q0: signed[16] out, q4: signed[16] out, qSum: signed[16] out,
    // the control: the same constant with no loop around it, which always worked
    plain: signed[16] out,
    // a loop whose body's negative value does not mention the index at all
    noIndex: signed[16] out
}
impl Neg {
    let v: signed[16][4];
    for k in 0..3 { v[k] = signed[16](k - 5); }
    n0 = v[0]; n1 = v[1]; n2 = v[2]; n3 = v[3];
    nSum = v[0] + v[1] + v[2] + v[3];

    // A descending range writes the same four elements, counting down.
    let d: signed[16][4];
    for i in 3..0 { d[i] = signed[16](0 - i); }
    d0 = d[0]; d3 = d[3];
    dSum = d[0] + d[1] + d[2] + d[3];

    // The loop bounds themselves are negative, so the index arrives negative
    // as well as the value.
    let b: signed[16][5];
    for i in -2..2 { b[i + 2] = signed[16](i * 3); }
    b0 = b[0]; b1 = b[1]; b2 = b[2]; b3 = b[3]; b4 = b[4];

    // A product that crosses from negative to positive across the range.
    let q: signed[16][5];
    for i in 0..4 { q[i] = signed[16](i * i - 10); }
    q0 = q[0]; q4 = q[4];
    qSum = q[0] + q[1] + q[2] + q[3] + q[4];

    let p: signed[16][1];
    p[0] = signed[16](0 - 5);
    plain = p[0];

    let z: signed[16][1];
    for i in 0..0 { z[0] = signed[16](0 - 7); }
    noIndex = z[0];
}

#[test]
entity GenerateNegativeTest {}
impl GenerateNegativeTest {
    let n: Neg = {};
    await 1ns;

    // `k - 5`, element by element rather than by sum — a sum can hide a sign
    // error that cancels.
    assert!(n.n0 == -5, "k = 0 gives -5");
    assert!(n.n1 == -4, "k = 1 gives -4");
    assert!(n.n2 == -3, "k = 2 gives -3");
    assert!(n.n3 == -2, "k = 3 gives -2");
    assert!(n.nSum == -14, "and they sum to -14");

    // A descending range still writes every element, and the values are the
    // negation of the index.
    assert!(n.d0 == 0, "`0 - 0` is 0");
    assert!(n.d3 == -3, "`0 - 3` is -3");
    assert!(n.dSum == -6, "summing to -6");

    // Negative loop bounds: the index is negative for the first two turns.
    assert!(n.b0 == -6, "i = -2 gives -6");
    assert!(n.b1 == -3, "i = -1 gives -3");
    assert!(n.b2 == 0, "i = 0 gives 0");
    assert!(n.b3 == 3, "i = 1 gives 3");
    assert!(n.b4 == 6, "and i = 2 gives 6");

    // Crossing zero within one loop.
    assert!(n.q0 == -10, "i = 0 gives -10");
    assert!(n.q4 == 6, "i = 4 gives 6");
    assert!(n.qSum == -20, "summing to -20");

    // The control: this shape was never broken, and must not become so.
    assert!(n.plain == -5, "a negative constant outside a loop is still -5");

    // The narrowest statement of the bug: the loop alone was enough.
    assert!(n.noIndex == -7, "a loop body's negative constant needs no index");

    // The testbench evaluates the same arithmetic through its own engine, so
    // the two are compared against each other as well as against Python.
    let t0: signed[16] = signed[16](0 - 5);
    let t3: signed[16] = signed[16](3 - 5);
    await 1ns;
    assert!(t0 == -5, "the testbench folds a negative the same way");
    assert!(t3 == -2, "across the range");
    assert!(t0 == n.n0, "and both engines agree");
    assert!(t3 == n.n3, "on every element");
}
