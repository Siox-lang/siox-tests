// std::float: IEEE-754 floating point written in siox, after VHDL's float_pkg.
// The index range gives the format: float[8..-23] is binary32, float[5..-10]
// binary16. Conversions, the special values, and rounding to nearest even.
// Slice 1 runs in test processes; a hardware entity's float arithmetic waits
// for the shared hardware lowering (see std.md).
module float_test;

use std::float::{float, to_float};

#[test]
entity FloatTest {}

impl FloatTest {

    let x: float[8..-23];
    let y: float[8..-23];
    let r: float[8..-23];
    let inf: float[8..-23];
    let zero: float[8..-23];
    let h: float[5..-10];
    let k: float[5..-10];
    let hr: float[5..-10];

    check: process {
        x = to_float(1.5, 8, 23);
        y = to_float(0.0 - 2.25, 8, 23);
        inf = to_float(1.0 / 0.0, 8, 23);
        zero = to_float(0.0, 8, 23);
        await 1ns;
        assert!(x == 1069547520, "1.5 is 0x3FC00000");
        assert!(y.to_real() == 0.0 - 2.25, "to_real");
        assert!(y < x and x > y and x >= x and x != y, "ordering");
        assert!(y.negate().to_real() == 2.25 and y.abs() == y.negate(), "negate and abs");

        r = x * y;
        await 1ns;
        assert!(r.to_real() == 0.0 - 3.375, "1.5 * -2.25");
        r = x + y;
        await 1ns;
        assert!(r.to_real() == 0.0 - 0.75, "1.5 + -2.25");
        r = x - x;
        await 1ns;
        assert!(r.is_zero() and r == zero, "x - x is zero");

        // Ties round to the even neighbour: 1 + 2^-24 is halfway to the next
        // binary32 after 1.0 and stays 1.0; 1 + 3 * 2^-25 rounds up.
        // `to_float` gives the word: store it in a float before arithmetic.
        x = to_float(1.0, 8, 23);
        y = to_float(0.000000059604644775390625, 8, 23);
        await 1ns;
        r = x + y;
        await 1ns;
        assert!(r == 1065353216, "a tie rounds to even");
        y = to_float(0.0000000894069671630859375, 8, 23);
        await 1ns;
        r = x + y;
        await 1ns;
        assert!(r == 1065353217, "above a tie rounds up");
        x = to_float(1.5, 8, 23);

        r = inf * zero;
        await 1ns;
        assert!(r.is_nan(), "infinity times zero is NaN");
        r = inf - inf;
        await 1ns;
        assert!(r.is_nan(), "infinity minus infinity is NaN");
        r = inf + x;
        await 1ns;
        assert!(r.is_infinite() and r > x, "infinity absorbs a number");
        y = to_float(300000000549775575777803994281145270272.0, 8, 23);
        await 1ns;
        r = x * y * y;
        await 1ns;
        assert!(r.is_infinite(), "overflow is infinite");
        assert!(zero.negate() == zero, "-0 equals +0");

        // binary16 shares the code: only the range differs.
        h = to_float(0.5, 5, 10);
        k = to_float(3.0, 5, 10);
        await 1ns;
        hr = h * k + h;
        await 1ns;
        assert!(hr.to_real() == 2.0, "0.5 * 3 + 0.5 in binary16");
        assert!(h == 14336, "0.5 is 0x3800 in binary16");

    }
}
