module examples::connect_forms_test;

using std::bits::unsigned;

// An entity port is connected in one of two struct-style block forms:
// explicit (`.a = x`) or positional (`x` by order) — spec 3.12 has no bare
// `.port` shorthand, and a block is all of one form or all of the other.
// Ports may also be wired post-declaration through the instance
// (`dut.a = x`, `dut.y`).
//
// Either block form may carry a *value* rather than a name. Elaboration binds
// a connection by the name it references and has nothing to bind for a value,
// so those used to leave the port at its default and read zero, while
// hardware lowered the same connection to a constant driver.
entity Add {
    a: unsigned[8] in,
    b: unsigned[8] in,
    y: unsigned[8] out
}

impl Add {
    y = a + b;
}

// Form 3 (positional) + post-declaration wiring inside a structural entity:
// chain two adders, connecting each stage's ports by position and by
// instance-qualified assignment.
entity Chain {
    x: unsigned[8] in,
    z: unsigned[8] out
}

impl Chain {
    let s1: Add = {};      // ports wired post-declaration
    let s2: Add = {};
    s1.a = x;
    s1.b = 1;
    s2.a = s1.y;          // s1 output feeds s2 input
    s2.b = 2;
    z = s2.y;
}

// The same value-carrying connection written in hardware rather than in a
// testbench, as a control for the testbench results below.
entity WrapValues {
    z: unsigned[8] out
}

impl WrapValues {
    let inner: Add = { .a = 5, .b = 6 };
    z = inner.y;
}

#[test]
entity ConnectFormsTest {}

impl ConnectFormsTest {
    let a: unsigned[8];
    let b: unsigned[8];
    let y: unsigned[8];

    // Form 1: explicit named connection.
    let named: Add = { .a = a, .b = b, .y = y };

    a = 10;
    b = 20;
    assert!(y == 30, "explicit named");

    // Form 3 + post-declaration: drive Chain's input and read its output.
    let x: unsigned[8];
    let z: unsigned[8];
    let chain: Add = { x, x, z };   // positional: a = x, b = x, y = z
    x = 7;
    assert!(z == 14, "positional a=b=x");

    // Post-declaration form: instantiate empty, then wire through the instance.
    let dut: Add = {};
    dut.a = 3;
    dut.b = 4;
    assert!(dut.y == 7, "post-declaration dut.a / dut.y");

    // Either block form may carry a value instead of a name.
    let litNamed: Add = { .a = 5, .b = 6 };
    assert!(litNamed.y == 11, "explicit connection carries a literal");

    let litPositional: Add = { 5, 6 };
    assert!(litPositional.y == 11, "positional connection carries a literal");

    let mixedNamed: Add = { .a = a, .b = 4 };
    assert!(mixedNamed.y == 14, "a name and a value in one block");

    let expr: Add = { .a = a + 1, .b = 4 };
    assert!(expr.y == 15, "a connection may be an expression");

    let inHardware: WrapValues = {};
    assert!(inHardware.z == litNamed.y, "parity with the same connection in hardware");
}
