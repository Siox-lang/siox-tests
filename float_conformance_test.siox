// Generated: 44 binary32 operand pairs, random and edge cases (a tie, a
// rounding up, cancellation, overflow), each multiplied, added and subtracted
// by std::float and checked bit for bit against Python's IEEE-754 binary32
// result (struct.pack('>f') rounds to nearest even). Operands are chosen so
// every exact result is representable in a double, so the reference rounds
// once.
module float_conformance_test;
use std::float::{float, to_float};
#[test]
entity FloatConformanceTest {}
impl FloatConformanceTest {
    let x: float[8..-23];
    let y: float[8..-23];
    let r: float[8..-23];
    check: process {
        x = to_float(0.0 - 22.020904541015625, 8, 23); y = to_float(0.0 - 3.2867658138275146, 8, 23); await 1ns;
        r = x * y; await 1ns;
        assert!(r == 1116782927, "-22.020904541015625 * -3.2867658138275146");
        x = to_float(0.0 - 22.020904541015625, 8, 23); y = to_float(0.0 - 3.2867658138275146, 8, 23); await 1ns;
        r = x + y; await 1ns;
        assert!(r == 3251271196, "-22.020904541015625 + -3.2867658138275146");
