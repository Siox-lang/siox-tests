module examples::derive_chain_test;
using std::logic::{ULogic};

// The two ways a type builds on another after extension was dropped (§3.28):
// newtype derivation (`:`, same representation, new identity) and composition.
// An enum that wants more cases declares its own full set and converts with an
// explicit `From` — it cannot extend its way to values the base cannot name.
enum Base { A, B }
enum Extended { A, B, C }

impl From<Base> for Extended {
    fn from(v: Base) -> Extended {
        if v == Base::B {
            return Extended::B;
        }
        return Extended::A;
    }
}

struct Header { valid: Bit, kind: unsigned[4] }
struct Packet { header: Header, data: unsigned[8] }

entity DUT {
    in u: ULogic;
    in v: Bit; in k: unsigned[4]; in dt: unsigned[8];
    out lg: Logic;         // ULogic -> Logic (newtype derivation, auto)
    out hk: unsigned[4];       // reach into the composed Header
    out ext: Extended;     // Base -> Extended (explicit From)
}
impl DUT {
    lg = Logic(u);
    let pkt: Packet;
    pkt = Packet { .header = Header { .valid = v, .kind = k }, .data = dt };
    hk = pkt.header.kind;
    let b: Base = Base::A;
    ext = Extended(b);
}

#[test]
entity ChainTest {}
impl ChainTest {
    let u: ULogic = 'Z';
    let v: Bit = '1'; let k: unsigned[4] = 7; let dt: unsigned[8] = 42;
    let lg: Logic; let hk: unsigned[4]; let ext: Extended;
    let d: DUT = { .u = u, .v = v, .k = k, .dt = dt, .lg = lg, .hk = hk, .ext = ext };
    await 1ns;
    assert!(lg == 'Z', "ULogic -> Logic keeps 'Z'");
    assert!(hk == 7, "composed Header field");
    assert!(ext == Extended::A, "Base -> Extended via From keeps A");
}
