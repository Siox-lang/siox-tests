module examples::ffi_test;

extern "C" {
    pub fn labs(v: integer) -> integer;
}

entity Abs { in x: signed[8]; out y: unsigned[8]; }
impl Abs { y = unsigned[8](labs(sext(x))); }

#[test]
entity FfiTest {}
impl FfiTest {
    let x: signed[8]; let y: unsigned[8];
    let d: Abs = { .x = x, .y = y };
    x = 236;  // -20
    await 1ns;
    assert!(y == 20, "labs(-20) == 20 via libc in hardware");
}
