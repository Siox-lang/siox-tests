module examples::ffi_test;

using CWord = integer;
using CInteger = CWord;

extern "C" {
    pub fn labs(v: CInteger) -> CInteger;
}

entity Abs { x: signed[8] in, y: unsigned[8] out }
impl Abs { y = unsigned[8](labs(sext(x))); }

entity ClockedAbs {
    clk: Bit in,
    x: integer<-128..127> in,
    y: integer<-128..127> out
}
impl ClockedAbs {
    if clk.rising() {
        y = labs(x);
    }
}

#[test]
entity FfiTest {}
impl FfiTest {
    let x: signed[8]; let y: unsigned[8];
    let d: Abs = { .x = x, .y = y };
    let clk: Bit = '0';
    let ix: integer<-128..127> = -20;
    let direct: CInteger = labs(ix);
    let iy: integer<-128..127>;
    let clocked: ClockedAbs = { .clk = clk, .x = ix, .y = iy };
    x = 236;  // -20
    await 1ns;
    assert!(y == 20, "labs(-20) == 20 via libc in hardware");
    assert!(direct == 20, "aliased integer C ABI in the native testbench");
    clk = '1';
    await 1ns;
    assert!(iy == 20, "constrained integer C return in a clocked update");
}
