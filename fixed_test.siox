// std::fixed: fixed point after VHDL's fixed_pkg, the format given by the
// type's parameters (`ufixed<8, 4>` is 4.4: 8 bits, 4 of them fraction). Arithmetic, signed products and their
// rounding, division, comparisons, the constructor from a number
// (`ufixed<8, 4>(2.5)`, in a process and in hardware) and from another format
// (a resize), back to real, and a clocked multiply-accumulate.
module fixed_test;

use std::fixed::{ufixed, sfixed};

// acc <= acc + a * b on every rising edge, in 8.8 signed fixed point.
entity Mac { clk: Bit in, a: sfixed<16, 8> in, b: sfixed<16, 8> in, acc: sfixed<16, 8> out }

impl Mac {
    let total: sfixed<16, 8> = 0;
    step: process {
        if clk.rising() {
            total = total + a * b;
        }
    }
    acc = total;
}

// The unsigned and signed operations, combinationally.
entity UArith { a: ufixed<8, 4> in, b: ufixed<8, 4> in, sum: ufixed<8, 4> out, diff: ufixed<8, 4> out, product: ufixed<8, 4> out, square: ufixed<8, 4> out, quotient: ufixed<8, 4> out, wide: ufixed<12, 6> out }

impl UArith {
    sum = a + b;
    diff = a - b;
    product = a * b;
    square = b * b;
    quotient = a / b;
    wide = ufixed<12, 6>(a);
}

entity SArith { a: sfixed<8, 4> in, b: sfixed<8, 4> in, product: sfixed<8, 4> out, square: sfixed<8, 4> out, quotient: sfixed<8, 4> out }

impl SArith {
    product = a * b;
    square = a * a;
    quotient = a / b;
}

// Constants built in hardware: the constructor reads the format it builds.
entity Offset { a: ufixed<8, 4> in, y: ufixed<8, 4> out, z: sfixed<8, 4> out }

impl Offset {
    y = a + ufixed<8, 4>(1.25);
    z = sfixed<8, 4>(0 - 2);
}

#[test]
entity FixedTest {}

impl FixedTest {
    // 2.5 and 1.5 in 4.4: the words 40 and 24.
    let a: ufixed<8, 4> = ufixed<8, 4>(2.5);
    let b: ufixed<8, 4> = ufixed<8, 4>(1.5);
    let sum: ufixed<8, 4>;
    let diff: ufixed<8, 4>;
    let product: ufixed<8, 4>;
    let unused: ufixed<8, 4>;
    let big: ufixed<8, 4> = ufixed<8, 4>(12.5);
    let wrapped: ufixed<8, 4>;
    let quotient: ufixed<8, 4>;
    let wide: ufixed<12, 6>;
    let unused_wide: ufixed<12, 6>;
    let u: UArith = { .a = a, .b = b, .sum = sum, .diff = diff, .product = product, .square = unused, .quotient = quotient, .wide = wide };
    let w: UArith = { .a = big, .b = big, .sum = unused, .diff = unused, .product = wrapped, .square = unused, .quotient = unused, .wide = unused_wide };

    let n: sfixed<8, 4> = sfixed<8, 4>(0.0 - 2.5);
    let p: sfixed<8, 4> = sfixed<8, 4>(1.5);
    let tiny: sfixed<8, 4> = sfixed<8, 4>(0.0 - 0.0625);
    let np: sfixed<8, 4>;
    let nn: sfixed<8, 4>;
    let floored: sfixed<8, 4>;
    let spare: sfixed<8, 4>;
    let signed_quotient: sfixed<8, 4>;
    let s1: SArith = { .a = n, .b = p, .product = np, .square = nn, .quotient = signed_quotient };
    let s2: SArith = { .a = tiny, .b = p, .product = floored, .square = spare, .quotient = spare };

    let clk: Bit = '0';
    let x: sfixed<16, 8> = sfixed<16, 8>(1.5);
    let y: sfixed<16, 8> = sfixed<16, 8>(0.0 - 0.5);
    let acc: sfixed<16, 8>;
    let mac: Mac = { .clk = clk, .a = x, .b = y, .acc = acc };
    let offset_y: ufixed<8, 4>;
    let offset_z: sfixed<8, 4>;
    let offset: Offset = { .a = a, .y = offset_y, .z = offset_z };
    clk = not clk after 5ns;

    check: process {
        await 1ns;
        assert!(a == 40 and b == 24, "2.5 and 1.5 are the 4.4 words 40 and 24");
        assert!(sum.to_real() == 4.0, "2.5 + 1.5");
        assert!(diff.to_real() == 1.0, "2.5 - 1.5");
        assert!(product.to_real() == 3.75, "2.5 * 1.5");
        assert!(wrapped.to_real() == 12.25, "12.5 * 12.5 = 156.25 wraps to 12.25");
        assert!(a > b and b < a and a >= a, "unsigned comparison");

        assert!(np.to_real() == 0.0 - 3.75, "-2.5 * 1.5");
        assert!(nn.to_real() == 6.25, "-2.5 * -2.5");
        assert!(floored.to_real() == 0.0 - 0.125, "-0.09375 rounds toward minus infinity");
        assert!(n < p and p > n and tiny < p, "signed comparison");

        assert!(ufixed<8, 4>(2.53) == 40, "rounds to the nearest 1/16");
        assert!(ufixed<8, 4>(100.0) == 255, "saturates high");
        assert!(ufixed<8, 4>(0.0 - 1.0) == 0, "saturates at zero");
        assert!(sfixed<8, 4>(0.0 - 100.0) == 0 - 128, "saturates low");
        assert!(sfixed<8, 4>(0.0 - 2.53) == 0 - 40, "rounds a negative to nearest");
        assert!(ufixed<8, 4>(3) == 48, "an integer converts by value");

        // Division keeps the format, rounding toward minus infinity.
        assert!(quotient.to_real() == 1.625, "2.5 / 1.5 in hardware");
        assert!(signed_quotient.to_real() == 0.0 - 1.6875, "-2.5 / 1.5 in hardware");
        assert!((a / b).to_real() == 1.625, "2.5 / 1.5 in a process");
        assert!((n / p).to_real() == 0.0 - 1.6875, "-2.5 / 1.5 in a process");
        assert!((a / ufixed<8, 4>(0)).to_real() == 0.0, "a quotient by zero is zero");

        // Between formats, the constructor resizes: nearest step, saturating.
        assert!(wide.to_real() == 2.5, "4.4 to 6.6 in hardware");
        let fine: ufixed<12, 8> = ufixed<12, 8>(2.53125);
        assert!(ufixed<8, 4>(fine).to_real() == 2.5625, "a tie rounds away from zero");
        assert!(ufixed<4, 2>(big).to_real() == 3.75, "saturates high");
        assert!(sfixed<8, 4>(sfixed<16, 8>(0.0 - 2.53)).to_real() == 0.0 - 2.5625,
            "a negative tie rounds away from zero");
        assert!(sfixed<4, 2>(n).to_real() == 0.0 - 2.0, "saturates low");
        assert!(offset_y.to_real() == 3.75 and offset_z.to_real() == 0.0 - 2.0,
            "hardware constants from the constructor");

        await 30ns;
        // Three rising edges (5, 15, 25ns), each adding 1.5 * -0.5.
        assert!(acc.to_real() == 0.0 - 2.25, "the accumulator holds 3 * -0.75");
    }
}
