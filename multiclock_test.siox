module examples::multiclock_test;
using std::logic::{Logic};
using std::bits::unsigned;
entity Dual { cf: Bit in, cs: Bit in, a: unsigned[8] out, b: unsigned[8] out }
impl Dual {
    let va: unsigned[8] = 0; let vb: unsigned[8] = 0;
    if cf.rising() { va = va + 1; }
    if cs.rising() { vb = vb + 1; }
    a = va; b = vb;
}
#[test]
entity M {}
impl M {
    let cf: Bit = '0'; let cs: Bit = '0';
    let a: unsigned[8]; let b: unsigned[8];
    let d: Dual = { .cf = cf, .cs = cs, .a = a, .b = b };
    cf = not cf after 2ns;
    cs = not cs after 5ns;
    await 40ns;
    assert!(a == 10, "fast clock: 10 rises");
    assert!(b == 4, "slow clock: 4 rises");
}
