module examples::real_local_test;

using std::attrs::{test};
using std::math::{sqrt, pow, floor};

// Unconnected real-valued testbench storage still uses the simulator's
// bit-pattern representation. Operations must decode it to floating point and
// encode their result again, just like connected real signals.
struct Sample { value: real }

#[test]
entity RealLocalTest {}

impl RealLocalTest {
    let value: real = 1.5;
    let sample: Sample = { .value = 3.5 };
    let math_result: real = sqrt(9.0);

    assert!(value == 1.5, "real local initialization");
    print!("real local {} field {}", value, sample.value);

    value = value + 0.75;
    assert!(value == 2.25, "real local arithmetic");
    value = -value;
    assert!(value == -2.25, "real local unary negation");

    value = if 1 == 1 { 4.5 } else { 9.5 };
    assert!(value == 4.5, "real-valued conditional");
    value = match 1 { 1 => 5.5, _ => 9.5 };
    assert!(value == 5.5, "real-valued match");

    sample.value = sample.value + 0.5;
    assert!(sample.value == 4.0, "real struct field arithmetic");

    assert!(math_result == 3.0, "extern sqrt in native testbench");
    math_result = pow(2.0, 3.0);
    assert!(math_result == 8.0, "extern pow in native testbench");
    print!("extern floor {}", floor(3.75));
}
