// The same 44 reference pairs as float_conformance_test, evaluated by
// continuously driven hardware operators, not procedural arithmetic.
module hardware_float_conformance_test;
use std::float::float;

entity FloatArithmetic {
    a: float<32, 23> in,
    b: float<32, 23> in,
    product: float<32, 23> out,
    sum: float<32, 23> out,
    difference: float<32, 23> out
}
impl FloatArithmetic {
    product = a * b;
    sum = a + b;
    difference = a - b;
}

#[test]
entity HardwareFloatConformanceTest {}
impl HardwareFloatConformanceTest {
    let x: float<32, 23>;
    let y: float<32, 23>;
    let product: float<32, 23>;
    let sum: float<32, 23>;
    let difference: float<32, 23>;
    let dut: FloatArithmetic = {
        .a = x, .b = y,
        .product = product, .sum = sum, .difference = difference
    };
    check: process {
        x = float<32, 23>(0.0 - 22.020904541015625); y = float<32, 23>(0.0 - 3.2867658138275146); await 1ns;
        assert!(product == 1116782927, "-22.020904541015625 * -3.2867658138275146");
        x = float<32, 23>(0.0 - 22.020904541015625); y = float<32, 23>(0.0 - 3.2867658138275146); await 1ns;
        assert!(sum == 3251271196, "-22.020904541015625 + -3.2867658138275146");
        x = float<32, 23>(0.0 - 22.020904541015625); y = float<32, 23>(0.0 - 3.2867658138275146); await 1ns;
        assert!(difference == 3247824772, "-22.020904541015625 - -3.2867658138275146");
        x = float<32, 23>(0.0 - 3420.509765625); y = float<32, 23>(0.0 - 6493.91943359375); await 1ns;
        assert!(product == 1269397457, "-3420.509765625 * -6493.91943359375");
        x = float<32, 23>(0.0 - 3420.509765625); y = float<32, 23>(0.0 - 6493.91943359375); await 1ns;
        assert!(sum == 3323652536, "-3420.509765625 + -6493.91943359375");
        x = float<32, 23>(0.0 - 3420.509765625); y = float<32, 23>(0.0 - 6493.91943359375); await 1ns;
        assert!(difference == 1161827982, "-3420.509765625 - -6493.91943359375");
        x = float<32, 23>(0.0 - 3536.008544921875); y = float<32, 23>(0.0 - 17.831363677978516); await 1ns;
        assert!(product == 1198935003, "-3536.008544921875 * -17.831363677978516");
        x = float<32, 23>(0.0 - 3536.008544921875); y = float<32, 23>(0.0 - 17.831363677978516); await 1ns;
        assert!(sum == 3311279472, "-3536.008544921875 + -17.831363677978516");
        x = float<32, 23>(0.0 - 3536.008544921875); y = float<32, 23>(0.0 - 17.831363677978516); await 1ns;
        assert!(difference == 3311133398, "-3536.008544921875 - -17.831363677978516");
        x = float<32, 23>(0.0 - 4.147144794464111); y = float<32, 23>(0.0 - 2074.696044921875); await 1ns;
