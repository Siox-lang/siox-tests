module examples::derive_test;

// Structure is composition (§3.28): a struct holds the one it builds on as a
// field rather than extending it, so `pkt.header.valid` says where the field
// lives. Derivation (`:`) only ever makes a newtype.
struct Header { valid: Bit, kind: unsigned[4] }
struct Packet { header: Header, data: unsigned[8] }

entity Rx { p_valid: Bit in, p_kind: unsigned[4] in, p_data: unsigned[8] in,
            ok: Bit out, d: unsigned[8] out }
impl Rx {
    let pkt: Packet;
    pkt = Packet { .header = Header { .valid = p_valid, .kind = p_kind }, .data = p_data };
    ok = pkt.header.valid;   // composed field
    d = pkt.data;            // own field
}

#[test]
entity SD {}
impl SD {
    let p_valid: Bit = '1'; let p_kind: unsigned[4] = 3; let p_data: unsigned[8] = 200;
    let ok: Bit; let d: unsigned[8];
    let r: Rx = { .p_valid = p_valid, .p_kind = p_kind, .p_data = p_data, .ok = ok, .d = d };
    await 1ns;
    assert!(ok == '1', "composed field valid");
    assert!(d == 200, "own field data");
}
