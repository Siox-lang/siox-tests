module examples::print_test;
using std::math::{sqrt};

entity Rt { x: real in, n: unsigned[8] in, y: real out }
impl Rt { y = sqrt(x); }

#[test]
entity S3Test {}
impl S3Test {
    let x: real = 9.0; let n: unsigned[8] = 42; let y: real;
    let d: Rt = { .x = x, .n = n, .y = y };
    await 1ns;
    print!("n = {} and sqrt({}) = {}", n, x, y);
    assert!(n == 42, "sanity");
    finish();
    assert!(n == 0, "unreachable after finish!");
}
