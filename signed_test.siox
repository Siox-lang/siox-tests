module examples::signed_test;
use std::primitive::Bool;
use std::bits::{signed, unsigned};

// Signed comparison comes from std's `impl Ord<signed> for signed` — not the
// compiler.
entity Cmp {
    a: signed[8] in,
    b: signed[8] in,
    lt: Bool out,
    ge: Bool out
}
impl Cmp {
    lt = a < b;
    ge = a >= b;
}

// Control: unsigned keeps the kernel's unsigned compare.
entity UCmp { a: unsigned[8] in, b: unsigned[8] in, lt: Bool out }
impl UCmp { lt = a < b; }

#[test]
entity SignedTest {}
impl SignedTest {
    let a: signed[8]; let b: signed[8];
    let lt: Bool; let ge: Bool;
    let d: Cmp = { .a = a, .b = b, .lt = lt, .ge = ge };
    let ua: unsigned[8]; let ub: unsigned[8]; let ult: Bool;
    let u: UCmp = { .a = ua, .b = ub, .lt = ult };

    a = 255;   // -1 as signed[8] two's complement
    b = 1;
    ua = 255; ub = 1;
    await 1ns;
    assert!(lt == true, "signed: -1 < 1");
    assert!(ge == false, "signed: not -1 >= 1");
    assert!(ult == false, "unsigned control: 255 > 1");

    a = 200;   // -56
    b = 156;   // -100
    await 1ns;
    assert!(lt == false, "signed: -56 > -100 (same sign)");
    assert!(ge == true, "signed: -56 >= -100");

    a = 5; b = 5;
    await 1ns;
    assert!(ge == true, "signed: 5 >= 5");
    assert!(lt == false, "signed: not 5 < 5");

    // At 64 bits the sign test's shift is the kernel integer's own, which
    // fills with the sign: the order must not depend on that.
    let w: signed[64] = 0 - 3;
    let z: signed[64] = 2;
    await 1ns;
    assert!(w < z and not (z < w) and w <= z and z >= w, "signed[64]: -3 < 2");
}
