module wide_test;

using std::bits::{unsigned};

entity WideAdder {
    a: unsigned[128] in,
    b: unsigned[128] in,
    y: unsigned[128] out,
    difference: unsigned[128] out,
    shifted: unsigned[128] out,
    events: unsigned[3] out
}

impl WideAdder {
    y = a + b;
    difference = a - b;
    shifted = a << 65;
    if a'event {
        events = events + 1;
    }
}

struct WideBox { value: unsigned[128] }
struct NarrowWideBox { value: unsigned[80] }

#[test]
entity WideTest {}

impl WideTest {
    let a: unsigned[128] = unsigned[128](x"FFFFFFFFFFFFFFFF");
    let b: unsigned[128] = 1;
    let y: unsigned[128];
    let difference: unsigned[128];
    let shifted: unsigned[128];
    let events: unsigned[3];
    let previous_events: unsigned[3];
    let wide_box: WideBox = {
        .value = 340282366920938463463374607431768211455
    };
    let narrow_box: NarrowWideBox = {
        .value = 1208925819614629174706175
    };
    let local_words: unsigned[128][2] = [
        340282366920938463463374607431768211455,
        1
    ];
    let copied_words: unsigned[128][2] = local_words;
    let dut: WideAdder = {
        .a = a,
        .b = b,
        .y = y,
        .difference = difference,
        .shifted = shifted,
        .events = events,
    };

    a = unsigned[128](x"FFFFFFFFFFFFFFFF");
    b = 1;
    await 1ns;
    assert!(events == 1, "low-word change raises event");
    assert!(
        y == (unsigned[128](1) << 64),
        "carry reaches the next ABI word without changing the other bits"
    );

    a = 0;
    b = 1;
    await 1ns;
    assert!(
        difference == x"FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF",
        "subtraction borrows across ABI words"
    );
    assert!(difference > a, "wide comparison observes high words");

    a = 1;
    await 1ns;
    assert!(events > 1, "second low-word change raises a fresh event");
    assert!(
        shifted == (unsigned[128](1) << 65),
        "shift crosses an ABI-word boundary"
    );

    previous_events = events;
    a = unsigned[128](1) << 100;
    await 1ns;
    assert!(
        a == (unsigned[128](1) << 100),
        "testbench writes preserve high words"
    );
    assert!(
        events > previous_events,
        "a high-word-only change raises a fresh event"
    );

    assert!(
        wide_box.value == 340282366920938463463374607431768211455,
        "a local struct field preserves all 128 bits"
    );
    narrow_box.value = narrow_box.value + 1;
    assert!(
        narrow_box.value == 0,
        "an 80-bit field wraps even when the harness value is 128 bits"
    );
    assert!(
        local_words[0] == 340282366920938463463374607431768211455,
        "an unconnected wide array preserves each element"
    );
    assert!(copied_words[0] == local_words[0], "wide arrays copy element-wise");
    local_words = [3, 4];
    assert!(local_words[1] == 4, "wide array literals can be reassigned");
}
