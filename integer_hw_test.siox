module integer_hw_test;

using SmallInteger = integer<-16..15>;
using SmallAlias = SmallInteger;

entity IntegerOps {
    a: integer<-16..15> in,
    b: integer<-16..15> in,
    choose_a: Bit in,
    less: Bit out,
    nested_less: Bit out,
    quotient: integer<-16..15> out,
    shifted: integer<-16..15> out,
    nested_quotient: integer<-128..127> out,
    widened: integer<-128..127> out,
    negated_quotient: integer<-128..127> out,
    summed_quotient: integer<-128..127> out
}

impl IntegerOps {
    less = if a < b { '1' } else { '0' };
    nested_less = if (if choose_a == '1' { a } else { -100 }) < 0 { '1' } else { '0' };
    quotient = a / b;
    shifted = a >> 1;
    nested_quotient = (if choose_a == '1' { a } else { -100 }) / 3;
    widened = a;
    negated_quotient = (-a) / 1;
    summed_quotient = (a + 1) / 3;
}

entity NaturalOps {
    value: integer<0..3> in,
    greater: Bit out
}
impl NaturalOps {
    greater = if value > 1 { '1' } else { '0' };
}

entity AliasIntegerOps {
    value: SmallAlias in,
    copy: SmallAlias out,
    negative: Bit out
}
impl AliasIntegerOps {
    copy = value;
    negative = if value < 0 { '1' } else { '0' };
}

#[test]
entity IntegerHardwareTest {}

impl IntegerHardwareTest {
    let a: integer<-16..15> = -8;
    let b: integer<-16..15> = 3;
    let choose_a: Bit = '1';
    let less: Bit;
    let nested_less: Bit;
    let quotient: integer<-16..15>;
    let shifted: integer<-16..15>;
    let nested_quotient: integer<-128..127>;
    let widened: integer<-128..127>;
    let negated_quotient: integer<-128..127>;
    let summed_quotient: integer<-128..127>;
    let natural: integer<0..3> = 3;
    let natural_greater: Bit;
    let alias_value: SmallAlias = -3;
    let alias_copy: SmallAlias;
    let alias_negative: Bit;
    let dut: IntegerOps = {
        .a = a,
        .b = b,
        .choose_a = choose_a,
        .less = less,
        .nested_less = nested_less,
        .quotient = quotient,
        .shifted = shifted,
        .nested_quotient = nested_quotient,
        .widened = widened,
        .negated_quotient = negated_quotient,
        .summed_quotient = summed_quotient,
    };
    let natural_dut: NaturalOps = { .value = natural, .greater = natural_greater };
    let alias_dut: AliasIntegerOps = {
        .value = alias_value,
        .copy = alias_copy,
        .negative = alias_negative,
    };

    await 1ns;
    assert!(less == '1', "kernel integer comparison in DUT is signed");
    assert!(nested_less == '1', "nested kernel integer comparison sign-extends selected values");
    assert!(quotient == -2, "kernel integer division in DUT is signed");
    assert!(shifted == -4, "kernel integer right shift in DUT is arithmetic");
    assert!(nested_quotient == -2, "nested kernel integer division sign-extends selected values");
    assert!(widened == -8, "widening a constrained kernel integer sign-extends");
    assert!(negated_quotient == 8, "nested kernel integer negation sign-extends its operand");
    assert!(summed_quotient == -2, "nested kernel integer addition sign-extends its operands");
    assert!(natural > 1, "nonnegative constrained integer compares by its numeric value");
    assert!(natural_greater == '1', "nonnegative constrained integer compares correctly in DUT");
    assert!(alias_copy == -3, "chained integer alias retains its stored value");
    assert!(alias_negative == '1', "chained integer alias retains signed comparison semantics");
}
