module examples::convert_test;

// T(x) conversions: widen (zero/sign per target), narrow, cross to kernel.
entity Conv {
    u8: unsigned[8] in,
    s8: signed[8] in,
    wide: unsigned[16] out,
    swide: signed[16] out,
    narrow: unsigned[4] out,
    rz: unsigned[16] out
}
impl Conv {
    wide = unsigned[16](u8);
    swide = signed[16](sext(s8));   // signed widening: sext then convert
    narrow = unsigned[4](u8);       // truncates
    rz = resize(u8, 16);        // family-preserving spelling
}

// Signed division + arithmetic shift, from std source.
entity SMath {
    a: signed[8] in,
    b: signed[8] in,
    q: signed[8] out,
    sh: signed[8] out
}
impl SMath {
    q = a / b;
    sh = a >> 1;
}

#[test]
entity S2Test {}
impl S2Test {
    let u8: unsigned[8] = 200; let s8: signed[8] = 240;   // s8 = -16
    let wide: unsigned[16]; let swide: signed[16]; let narrow: unsigned[4]; let rz: unsigned[16];
    let c: Conv = { .u8 = u8, .s8 = s8, .wide = wide, .swide = swide, .narrow = narrow, .rz = rz };

    let a: signed[8] = 236;   // -20
    let b: signed[8] = 3;
    let q: signed[8]; let sh: signed[8];
    let m: SMath = { .a = a, .b = b, .q = q, .sh = sh };

    await 1ns;
    assert!(wide == 200, "zero-extend");
    assert!(swide == 65520, "sign-extend: -16 in 16 bits = 0xFFF0");
    assert!(narrow == 8, "truncate: 200 & 0xF");
    assert!(rz == 200, "resize spelling");
    assert!(q == 250, "-20 / 3 = -6 (0xFA)");
    assert!(sh == 246, "-20 >> 1 arithmetic = -10 (0xF6)");

    b = 253;   // -3
    await 1ns;
    assert!(q == 6, "-20 / -3 = 6");
}
