module examples::string_test;

// Fixed text is `Char[N]`: a literal supplies the length, and whole-text
// equality compares symbol by symbol. (Growable text is `String`.)

entity Echo {
    s: Char[5] in,
    o: Char[5] out
}

impl Echo {
    o = s;
}

#[test]
entity StringTest {}

impl StringTest {
    let s: Char[5] = "hello";
    let o: Char[5];

    let dut: Echo = { .s = s, .o = o };

    await 1ns;
    assert!(o == "hello", "the echoed string matches the input");

    s = "world";
    await 1ns;
    assert!(o == "world", "reassignment propagates through");
    assert!(o != "hello", "and no longer matches the old value");
}
