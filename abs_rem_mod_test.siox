// `abs`, `rem`, `mod`, `min` and `max` are functions in `std::math`, as in
// mathematics, generic over the numeric types: a call inlines, so the body
// uses the argument type's own operators. `rem` takes the dividend's sign
// (VHDL `rem`, Rust `%`), `mod` the divisor's (VHDL `mod`). Checked on
// `integer`, `real`, `signed` and `unsigned` in hardware and in a process,
// and on the fixed formats.
module abs_rem_mod_test;
use std::bits::{signed, unsigned};
use std::fixed::{sfixed, ufixed};
use std::math::{abs, rem, mod, min, max};

entity SignedOps {
    a: signed[8] in,
    m: signed[8] in,
    magnitude: signed[8] out,
    remainder: signed[8] out,
    modulus: signed[8] out,
    least: signed[8] out
}
impl SignedOps {
    magnitude = abs(a);
    remainder = rem(a, m);
    modulus = mod(a, m);
    least = min(a, m);
}

#[test]
entity AbsRemModTest {}
impl AbsRemModTest {
    let a: signed[8] = 0 - 7;
    let m: signed[8] = 2;
    let magnitude: signed[8];
    let remainder: signed[8];
    let modulus: signed[8];
    let least: signed[8];
    let ops: SignedOps = {
        .a = a, .m = m,
        .magnitude = magnitude, .remainder = remainder, .modulus = modulus,
        .least = least
    };
    let u: unsigned[8] = 23;
    let s: sfixed[3..-4] = sfixed[3..-4](0.0 - 1.25);
    let f: ufixed[3..-4] = ufixed[3..-4](2.5);

    check: process {
        let n: integer = 0 - 7;
        assert!(abs(n) == 7, "integer abs");
        assert!(rem(n, 2) == 0 - 1, "integer rem takes the dividend's sign");
        assert!(mod(n, 2) == 1, "integer mod takes the divisor's sign");
        assert!(mod(7, 0 - 2) == 0 - 1, "integer mod with a negative divisor");
        assert!(rem(7, 0 - 2) == 1, "integer rem with a negative divisor");
        assert!(mod(6, 3) == 0, "an exact multiple has no remainder");
        assert!(min(n, 3) == n and max(n, 3) == 3, "integer min and max");

        let r: real = 0.0 - 2.5;
        assert!(abs(r) == 2.5, "real abs");
        assert!(max(r, 1.0) == 1.0, "real max");

        await 1ns;
        assert!(magnitude == 7, "signed abs in hardware");
        assert!(remainder == 0 - 1, "signed rem in hardware");
        assert!(modulus == 1, "signed mod in hardware");
        assert!(least == 0 - 7, "signed min in hardware compares signed");
        assert!(abs(a) == 7, "signed abs in a process");
        assert!(rem(a, m) == 0 - 1, "signed rem in a process");
        assert!(mod(a, m) == 1, "signed mod in a process");

        m = 0 - 2;
        a = 7;
        await 1ns;
        assert!(remainder == 1, "signed rem, negative divisor");
        assert!(modulus == 0 - 1, "signed mod, negative divisor");

        assert!(abs(u) == 23, "unsigned abs is itself");
        assert!(rem(u, 5) == 3 and mod(u, 5) == 3, "unsigned rem and mod agree");

        assert!(abs(s).to_real() == 1.25, "sfixed abs");
        assert!(abs(f).to_real() == 2.5, "ufixed abs");
    }
}
